{
  "name": "dig-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3977",
    "build": "next build",
    "start": "next start -p 3977",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "serve:tailscale": "tailscale serve --bg 3977 && tailscale serve status",
    "serve:tailscale:off": "tailscale serve reset",
    "test": "vitest run && playwright test",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --ui"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "~16.4.3",
