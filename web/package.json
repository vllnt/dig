    "@vllnt/logger": "^0.1.2",
    "@vllnt/ui": "^0.2.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.61.0",
    "next": "~16.4.3",
    "next-intl": "4.13.4",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reading-time": "^1.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/typography": "^0.5.20",
