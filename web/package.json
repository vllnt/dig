    "@vitest/coverage-v8": "^5.0.5",
    "@vllnt/eslint-config": "^2.0.0",
    "@vllnt/typescript": "^2.0.0",
    "eslint": "^9.39.5",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "overrides": {
      "baseline-browser-mapping@<2.11.0": "^2.11.0",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=5 <5.0.7": "^5.0.7",
